    values/colors.xml v5 - navy_950/navy_900 day palette, accent_gold).
    The icon was still the OLD electric-blue branding from before that
    palette change, so the home-screen icon and the keyboard's own
    colors no longer matched at all. Same shield shape/composition,
    just the cream-to-warm-tan gradient that's actually used inside
    the app now.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#F5EEDA"
                android:endColor="#D8C495" />
        </aapt:attr>
    </path>
</vector>
