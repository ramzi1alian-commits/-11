<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_950"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/file_crypto_title"
            android:textColor="@color/white"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="18dp"
            android:text="@string/file_crypto_desc"
            android:textColor="@color/slate_400"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/file_contact_label"
            android:textColor="@color/slate_200"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/file_contact_spinner"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/file_add_contact"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="@string/file_add_contact" />

        <TextView
            android:id="@+id/file_selected_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:padding="14dp"
            android:background="@drawable/bg_input"
            android:text="@string/file_none_selected"
            android:textColor="@color/slate_200"
            android:maxLines="3"
            android:ellipsize="middle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/file_pick_encrypt"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/file_encrypt_btn" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/file_pick_decrypt"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:text="@string/file_decrypt_btn" />

        <TextView
            android:id="@+id/file_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="12dp"
            android:background="@drawable/bg_card"
            android:text="@string/file_session_inactive"
            android:textColor="@color/slate_400"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/file_open_encrypt"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:text="@string/file_open_encrypt"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
