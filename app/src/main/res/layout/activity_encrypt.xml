<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navy_950">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="4dp"
            android:text="@string/encrypt_title"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/encrypt_subtitle"
            android:textColor="@color/slate_400"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/rootWarningText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:background="@drawable/bg_warning"
            android:textColor="@color/danger_red"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/text_label"
            android:textColor="@color/slate_200"
            android:textSize="13sp" />

        <!--
            SECURITY FIX: textMultiLine alone leaves this field open to
            whatever keyboard is actually active on the device. If the
            user has NOT switched to SecureKeyboard as their system input
            method, their default keyboard (Gboard, SwiftKey, etc.) is the
            one actually capturing every keystroke typed here - and many
            of those keyboards have predictive-text/personalization
            features that can learn from, and in some cases sync, typed
            content. textNoSuggestions tells the active IME not to offer
            or record suggestions for this field, which is the standard
            Android signal an app can send to reduce that learning/
            leakage surface regardless of which keyboard the user has
            installed.
        -->
        <EditText
            android:id="@+id/inputText"
            style="@style/InputField"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:gravity="top|start"
            android:layout_marginBottom="16dp"
            android:hint="@string/text_hint"
            android:inputType="textMultiLine|textNoSuggestions"
            android:saveEnabled="false"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/key_label"
            android:textColor="@color/slate_200"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/inputKey"
            style="@style/InputField"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="4dp"
            android:hint="@string/key_hint"
            android:inputType="textPassword"
            android:saveEnabled="false"
            android:importantForAutofill="no" />

        <TextView
            android:id="@+id/keyStrengthHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:textColor="@color/slate_400"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGenerateKey"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="10dp"
            android:text="@string/generate_key_btn" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUseAsSessionKey"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="6dp"
            android:text="@string/use_as_session_key_btn" />

        <TextView
            android:id="@+id/sessionKeyStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/session_key_inactive"
            android:textColor="@color/slate_400"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/pairing_title"
            android:textColor="@color/slate_200"
            android:textSize="13sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddRecipient"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="8dp"
            android:text="@string/pairing_title" />

        <Spinner
            android:id="@+id/spinnerRecipient"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/noContactsHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/recipient_passphrase_only"
            android:textColor="@color/slate_400"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="@string/expiry_label"
            android:textColor="@color/slate_200"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinnerExpiry"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_input"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/inputCustomMinutes"
            style="@style/InputField"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:hint="@string/expiry_custom_hint"
            android:inputType="number"
            android:visibility="gone"
            android:saveEnabled="false"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="@string/expiry_warning_note"
            android:textColor="@color/slate_400"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEncryptAction"
                style="@style/PrimaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="@string/encrypt_btn" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDecryptAction"
                style="@style/SecondaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/decrypt_btn" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearAll"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:text="@string/clear_all_btn" />

        <TextView
            android:id="@+id/errorText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/danger_red"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/resultCard"
            style="@style/CardStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="20dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/result_label"
                android:textColor="@color/slate_200"
                android:textSize="13sp" />

            <!--
                textIsSelectable REMOVED on purpose: it let anyone
                long-press-drag-select the plaintext/ciphertext straight
                to the clipboard with no warning and no auto-clear. Now
                the only way to copy it is the explicit button below,
                which marks the clip sensitive and auto-clears it.
            -->
            <TextView
                android:id="@+id/resultText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/accent_cyan"
                android:textIsSelectable="false"
                android:textSize="13sp"
                android:layout_marginBottom="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCopyResult"
                style="@style/SecondaryButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="@string/copy_result_btn" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
