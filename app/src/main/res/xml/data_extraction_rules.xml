<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) rules. android:allowBackup="false" already
    disables Auto Backup entirely - this file is an explicit second layer
    covering the two Android-12+ data paths specifically: cloud backup
    and device-to-device transfer (the "copy my data" flow when setting
    up a new phone). Both are disabled outright so nothing in this app's
    private storage (theme/accent preferences, etc.) can ever leave the
    original device through those paths.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
